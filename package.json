{
  "name": "sunrise-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "typecheck:phase2": "tsc --noEmit -p tsconfig.phase2.json",
    "test": "vitest run tests/phase0 tests/phase1 tests/unit tests/phase2/phase2-contracts.contract.test.ts",
    "test:phase0": "vitest run tests/phase0",
    "test:phase1": "vitest run tests/phase1",
    "test:phase2": "vitest run tests/phase2",
    "test:contracts": "vitest run tests/phase0/governance-and-boundaries.contract.test.ts tests/phase0/shared-contracts.contract.test.ts tests/phase1/phase1-contracts.contract.test.ts tests/phase2/phase2-contracts.contract.test.ts",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
